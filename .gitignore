# =============================================
# Cloud Outage Prediction System — .gitignore
# =============================================

# Python Virtual Environment
.venv/
.venv-1/
venv/
env/
ENV/
.env
*.env.local

# Python Cache & Compiled Files
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.pyc
*.so
.Python

# ML Model Binary Files (large — regenerated by train_lstm.py on first run)
ml/model/lstm_model.keras
ml/model/rf_model.pkl
ml/model/scaler.pkl

# Keep metrics.json (lightweight, useful for reference)
!ml/model/metrics.json

# Pytest & Coverage
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# Jupyter Notebook Checkpoints
.ipynb_checkpoints/

# Log & Temp Files
*.log
*.tmp
*.temp
outage_stress_*.tmp

# OS-generated Files
.DS_Store
Thumbs.db
desktop.ini

# IDEs & Editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Generated Report & Scratch Files
scratch_*.py
generate_*.py
*.pdf
*.docx

# Docker Local Overrides
docker-compose.override.yml

# Prometheus Data Directory
prometheus_data/

# Secrets
secrets.env
.env.production
.env.local
